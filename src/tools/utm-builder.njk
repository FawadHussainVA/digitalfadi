<section class="wrap narrow pt0">
  <div class="prose">
    <h2>What a UTM link does</h2>
    <p>A UTM link is a normal URL with a few labels added to the end. When someone clicks it, Google Analytics reads the labels and files the visit under the source, medium and campaign you chose. Without them, a click from your newsletter or a partner site often shows up as direct traffic or a vague referral, and you cannot tell which effort produced the enquiry.</p>

    <h2>The parameters and what goes in each</h2>
    <ul>
      <li><strong>utm_source</strong> is where the click came from: newsletter, a partner's domain, a directory name.</li>
      <li><strong>utm_medium</strong> is the type of traffic: email, referral, affiliate, display. This is the one GA4 leans on most when choosing a channel.</li>
      <li><strong>utm_campaign</strong> is the specific push: spring-sale, boiler-service-2026, webinar-june.</li>
      <li><strong>utm_term</strong> and <strong>utm_content</strong> are optional. Content is useful for telling two links in the same email apart, such as a header button and a footer link.</li>
      <li><strong>utm_id</strong> is optional and mainly matters if you import cost data into GA4.</li>
    </ul>

    <h2>How GA4 decides the channel</h2>
    <p>GA4 does not read your campaign name to decide the channel. It applies fixed rules to the source and medium. A medium of email puts the visit in Email. A medium of referral puts it in Referral. A paid medium such as cpc combined with a search engine as the source puts it in Paid Search. Anything GA4 does not recognise, such as a medium of qr or print, lands in Unassigned, which is where a lot of offline and partner tracking quietly disappears. The checker above runs a simplified version of those rules so you can catch this before the link goes out.</p>

    <h2>UTMs and Google Ads</h2>
    <p>Google Ads should use auto-tagging, not hand-written UTMs. Auto-tagging adds a click ID that GA4 uses to pull in the campaign, ad group and keyword without any work from you. The Final URL suffix mode exists for a different job: many CRMs, call tracking tools and form plugins only read UTMs from the landing page, so a suffix with ValueTrack parameters lets those tools see which keyword produced each lead. If leads are arriving but nobody can say which campaign sent them, tracking is the first thing a <a href="/google-ads-audit/">$200 account analysis</a> checks.</p>

    <h2>A naming convention that survives a year</h2>
    <p>Most messy reports come from three habits: mixed capitals, spaces, and different people inventing their own values. Keep everything lowercase, use hyphens, and write your agreed sources and mediums down somewhere the whole team can see. Save the links you use here so the next one matches the last. When the tracked traffic is ready to judge, the <a href="/tools/metrics-calculator/">Google Ads metrics calculator</a> turns the numbers into CPA and ROAS, and there is more on reading results in <a href="/learn/why-are-my-google-ads-not-converting/">why your Google Ads are not converting</a>.</p>
  </div>
</section>

<script>
(function(){
  'use strict';
  var $ = function(id){ return document.getElementById(id); };
  var KEY = 'df_utm_v1';
  var FIELDS = ['uUrl','uSrc','uMed','uCamp','uId','uTerm','uCont'];
  var history = [];

  /* ---------- GA4 default channel group, simplified ---------- */
  var SEARCH = ['google','bing','yahoo','baidu','duckduckgo','ecosia','yandex','naver','ask','aol','startpage','qwant','brave','seznam'];
  var SOCIAL = ['facebook','fb','m.facebook.com','l.facebook.com','instagram','ig','linkedin','lnkd.in','twitter','t.co','x','x.com','pinterest','reddit','tiktok','snapchat','quora','threads','whatsapp','tumblr'];
  var VIDEO  = ['youtube','youtube.com','m.youtube.com','vimeo','twitch','dailymotion','wistia'];
  var SHOP   = ['shopping','google shopping','amazon','ebay','etsy','walmart','shopify','igshopping'];
  var PAID   = /^(.*cp.*|ppc|retargeting|paid.*)$/;
  var SHOPCAMP = /^(.*(([^a-df-z]|^)shop|shopping).*)$/;
  function inList(list, s){ return list.some(function(x){ return s === x || s.indexOf(x + '.') === 0 || s.indexOf('.' + x + '.') > -1; }); }

  function channel(s, m, c){
    s = s.toLowerCase(); m = m.toLowerCase(); c = c.toLowerCase();
    if (!s || !m) return null;
    if (c.indexOf('cross-network') > -1) return ['Cross-network', 'Campaign names containing cross-network are grouped here.'];
    var paid = PAID.test(m);
    if (paid && (inList(SHOP, s) || SHOPCAMP.test(c))) return ['Paid Shopping', 'A paid medium with a shopping source or a campaign name containing shop.'];
    if (paid && inList(SEARCH, s)) return ['Paid Search', 'A paid medium (cpc, ppc, paid) with a search engine as the source.'];
    if (paid && inList(SOCIAL, s)) return ['Paid Social', 'A paid medium with a social network as the source.'];
    if (paid && inList(VIDEO, s)) return ['Paid Video', 'A paid medium with a video site as the source.'];
    if (['display','banner','expandable','interstitial','cpm'].indexOf(m) > -1) return ['Display', 'The medium is display, banner, interstitial or cpm.'];
    if (paid) return ['Paid Other', 'The medium looks paid, but the source is not a recognised search, social, video or shopping site.'];
    if (inList(SHOP, s) || SHOPCAMP.test(c)) return ['Organic Shopping', 'The source is a shopping site or the campaign name contains shop.'];
    if (inList(SOCIAL, s) || ['social','social-network','social-media','sm','social network','social media'].indexOf(m) > -1) return ['Organic Social', 'The source is a social network or the medium is social.'];
    if (inList(VIDEO, s) || m.indexOf('video') > -1) return ['Organic Video', 'The source is a video site or the medium contains video.'];
    if (inList(SEARCH, s) || m === 'organic') return ['Organic Search', 'The source is a search engine or the medium is organic.'];
    if (['referral','app','link'].indexOf(m) > -1) return ['Referral', 'The medium is referral, app or link.'];
    if (/^(email|e-mail|e_mail|e mail)$/.test(s) || /^(email|e-mail|e_mail|e mail)$/.test(m)) return ['Email', 'The source or medium is email.'];
    if (m === 'affiliate') return ['Affiliates', 'The medium is affiliate.'];
    if (m === 'audio') return ['Audio', 'The medium is audio.'];
    if (s === 'sms' || m === 'sms') return ['SMS', 'The source or medium is sms.'];
    if (/push$/.test(m) || m.indexOf('mobile') > -1 || m.indexOf('notification') > -1 || s === 'firebase') return ['Mobile Push Notifications', 'The medium mentions push, mobile or notification.'];
    return ['Unassigned', 'GA4 does not recognise this medium, so the visit will not appear in any named channel. Try referral, email or affiliate, or set up a custom channel group.'];
  }

  /* ---------- value cleaning ---------- */
  function clean(v){
    v = v.trim();
    if ($('uLower').checked) v = v.toLowerCase();
    var sp = $('uSpace').value;
    if (sp !== 'enc') v = v.replace(/\s+/g, sp);
    return v;
  }

  function parseUrl(raw){
    raw = raw.trim();
    if (!raw) return null;
    if (!/^[a-z][a-z0-9+.-]*:\/\//i.test(raw)) raw = 'https://' + raw;
    try { var u = new URL(raw); return /\./.test(u.hostname) ? u : null; } catch(e){ return null; }
  }

  var lastLink = '';
  function build(){
    var raw = $('uUrl').value, u = parseUrl(raw);
    var src = clean($('uSrc').value), med = clean($('uMed').value), camp = clean($('uCamp').value);
    var pairs = [['utm_source', src], ['utm_medium', med], ['utm_campaign', camp],
                 ['utm_id', clean($('uId').value)], ['utm_term', clean($('uTerm').value)], ['utm_content', clean($('uCont').value)]];
    var checks = [], replaced = false;

    if (u){
      var keep = [];
      u.searchParams.forEach(function(val, key){
        if (/^utm_/i.test(key)) replaced = true; else keep.push(encodeURIComponent(key) + '=' + encodeURIComponent(val));
      });
      var add = pairs.filter(function(p){ return p[1]; }).map(function(p){ return p[0] + '=' + encodeURIComponent(p[1]); });
      var q = keep.concat(add).join('&');
      lastLink = (src && med && camp) ? u.origin + u.pathname + (q ? '?' + q : '') + u.hash : '';
    } else lastLink = '';

    var out = $('uOut');
    if (lastLink){ out.textContent = lastLink; out.classList.remove('empty'); }
    else { out.textContent = !raw.trim() ? 'Fill in the URL, source, medium and campaign name.' : (!u ? 'That URL does not look valid yet. Include the domain, for example yoursite.com/page.' : 'Add a source, medium and campaign name to finish the link.'); out.classList.add('empty'); }
    $('uLen').textContent = lastLink.length + ' characters';

    /* checks */
    checks.push([u ? 'ok' : 'no', u ? 'URL is valid' : 'Enter a valid website URL']);
    if (u && u.protocol === 'http:') checks.push(['mid', 'The URL uses http. Use https if the site supports it, or the redirect may strip the parameters.']);
    checks.push([src && med && camp ? 'ok' : 'no', src && med && camp ? 'Source, medium and campaign are filled in' : 'Source, medium and campaign name are all required']);
    var rawVals = ['uSrc','uMed','uCamp','uId','uTerm','uCont'].map(function(id){ return $(id).value; }).join('');
    if (!$('uLower').checked && /[A-Z]/.test(rawVals)) checks.push(['mid', 'Capital letters found. GA4 will report Email and email as separate rows.']);
    if ($('uSpace').value === 'enc' && /\s/.test(rawVals.trim())) checks.push(['mid', 'Values contain spaces, which become %20 and are easy to mistype next time.']);
    if (replaced) checks.push(['mid', 'The URL already had UTM parameters. They have been replaced with yours.']);
    if (u && u.hash) checks.push(['ok', 'The #' + u.hash.slice(1) + ' anchor is kept after the parameters, where it belongs.']);
    if (src === 'google' && PAID.test(med)) checks.push(['mid', 'For Google Ads, use auto-tagging rather than google / cpc by hand. Use the Final URL suffix tab if a CRM needs UTMs.']);
    $('uChecks').innerHTML = checks.map(function(c){
      return '<li class="tk-chk ' + c[0] + '"><i aria-hidden="true">' + (c[0] === 'ok' ? '\u2713' : '!') + '</i><span>' + esc(c[1]) + '</span></li>';
    }).join('');

    var ch = channel(src, med, camp), tag = $('uChan');
    if (!ch){ tag.textContent = 'Waiting for source and medium'; tag.className = 'tk-tag soft'; $('uChanWhy').textContent = 'GA4 sorts each visit into a default channel group using the source and medium. This shows where the link will most likely appear.'; }
    else { tag.textContent = ch[0]; tag.className = 'tk-tag ' + (ch[0] === 'Unassigned' ? 'bad' : 'good'); $('uChanWhy').textContent = ch[1]; }
    save();
  }

  function esc(t){ return String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  /* ---------- presets ---------- */
  var PRESETS = {
    newsletter: { uSrc:'newsletter', uMed:'email', uCamp:'', uCont:'' },
    gbp:        { uSrc:'google', uMed:'organic', uCamp:'gbp-listing', uCont:'website-button' },
    partner:    { uSrc:'partner-name', uMed:'referral', uCamp:'', uCont:'' },
    qr:         { uSrc:'flyer', uMed:'referral', uCamp:'', uCont:'qr-code' }
  };
  $('uPreset').addEventListener('change', function(){
    var p = PRESETS[this.value]; if (!p) return;
    Object.keys(p).forEach(function(k){ if (p[k] || !$(k).value) $(k).value = p[k]; });
    build();
  });

  /* ---------- copy, history ---------- */
  function copy(text, btn){
    if (!text) return;
    var done = function(){ var o = btn.textContent; btn.textContent = 'Copied'; setTimeout(function(){ btn.textContent = o; }, 1400); };
    if (navigator.clipboard) navigator.clipboard.writeText(text).then(done, function(){});
  }
  $('uCopy').addEventListener('click', function(){ copy(lastLink, this); });

  function drawHistory(){
    $('uHistN').textContent = history.length;
    $('uHistEmpty').hidden = history.length > 0;
    $('uHist').innerHTML = history.map(function(h, i){
      return '<li class="tk-chk ok" style="align-items:center"><span style="flex:1;min-width:0;word-break:break-all">' + esc(h) + '</span>' +
        '<button type="button" class="btn ghost sm" data-copy="' + i + '">Copy</button>' +
        '<button type="button" class="tk-x" data-del="' + i + '" aria-label="Remove saved link">&times;</button></li>';
    }).join('');
  }
  $('uHist').addEventListener('click', function(e){
    var b = e.target.closest('button'); if (!b) return;
    if (b.dataset.copy) copy(history[+b.dataset.copy], b);
    if (b.dataset.del){ history.splice(+b.dataset.del, 1); drawHistory(); save(); }
  });
  $('uSave').addEventListener('click', function(){
    if (!lastLink) return;
    history = [lastLink].concat(history.filter(function(h){ return h !== lastLink; })).slice(0, 15);
    drawHistory(); save();
    var b = this, o = b.textContent; b.textContent = 'Saved'; setTimeout(function(){ b.textContent = o; }, 1400);
  });
  $('uHistClear').addEventListener('click', function(){ history = []; drawHistory(); save(); });
  $('uReset').addEventListener('click', function(){
    FIELDS.forEach(function(id){ $(id).value = ''; }); $('uPreset').value = ''; build();
  });

  /* ---------- Final URL suffix ---------- */
  var SAMPLE = { '{keyword}':'emergency plumber', '{creative}':'712345678901', '{campaignid}':'20123456789',
    '{matchtype}':'p', '{device}':'m', '{network}':'g', '{adgroupid}':'151234567890', '{loc_physical_ms}':'1006886', '{_campaign}':'boiler-repair' };
  function suffix(){
    var lower = function(v){ return v.trim().toLowerCase().replace(/\s+/g, '-'); };
    var parts = [];
    var s = lower($('sSrc').value), m = lower($('sMed').value);
    if (s) parts.push('utm_source=' + encodeURIComponent(s));
    if (m) parts.push('utm_medium=' + encodeURIComponent(m));
    var mode = $('sCampMode').value;
    $('sFixedWrap').hidden = mode !== 'fixed';
    if (mode === 'custom') parts.push('utm_campaign={_campaign}');
    else if (mode === 'id') parts.push('utm_campaign={campaignid}');
    else if (lower($('sFixed').value)) parts.push('utm_campaign=' + encodeURIComponent(lower($('sFixed').value)));
    [].slice.call(document.querySelectorAll('.sOpt')).forEach(function(c){ if (c.checked) parts.push(c.value); });
    var sfx = parts.join('&');
    $('sOut').textContent = sfx;
    var ex = 'https://yoursite.com/boiler-repair?' + sfx.replace(/\{[_a-z]+\}/g, function(t){ return SAMPLE[t] !== undefined ? encodeURIComponent(SAMPLE[t]) : t; });
    $('sEx').textContent = ex;
    $('sNote').textContent = mode === 'custom'
      ? 'For {_campaign} to work, add a custom parameter named campaign at campaign level with a readable value, such as boiler-repair. Without it the value comes through empty.'
      : 'Values in the example are made up to show the format. Google fills in the real ones on every click.';
    save();
  }
  ['sSrc','sMed','sFixed'].forEach(function(id){ $(id).addEventListener('input', suffix); });
  $('sCampMode').addEventListener('change', suffix);
  [].slice.call(document.querySelectorAll('.sOpt')).forEach(function(c){ c.addEventListener('change', suffix); });
  $('sCopy').addEventListener('click', function(){ copy($('sOut').textContent, this); });

  /* ---------- tabs ---------- */
  [].slice.call(document.querySelectorAll('[data-mode]')).forEach(function(b){
    b.addEventListener('click', function(){
      var a = b.dataset.mode === 'a';
      $('utmModeA').hidden = !a; $('utmModeB').hidden = a;
      $('utmTabA').classList.toggle('on', a); $('utmTabB').classList.toggle('on', !a);
      $('utmTabA').setAttribute('aria-selected', a); $('utmTabB').setAttribute('aria-selected', !a);
    });
  });

  /* ---------- keep work in this browser ---------- */
  function save(){
    try {
      var d = { h: history, lower: $('uLower').checked, space: $('uSpace').value,
        sSrc: $('sSrc').value, sMed: $('sMed').value, sCampMode: $('sCampMode').value, sFixed: $('sFixed').value,
        sOpt: [].slice.call(document.querySelectorAll('.sOpt')).map(function(c){ return c.checked; }) };
      FIELDS.forEach(function(id){ d[id] = $(id).value; });
      localStorage.setItem(KEY, JSON.stringify(d));
    } catch(e){}
  }
  function restore(){
    try {
      var d = JSON.parse(localStorage.getItem(KEY) || 'null'); if (!d) return;
      FIELDS.forEach(function(id){ if (typeof d[id] === 'string') $(id).value = d[id]; });
      if (Array.isArray(d.h)) history = d.h.slice(0, 15);
      if (typeof d.lower === 'boolean') $('uLower').checked = d.lower;
      if (d.space) $('uSpace').value = d.space;
      ['sSrc','sMed','sCampMode','sFixed'].forEach(function(id){ if (typeof d[id] === 'string') $(id).value = d[id]; });
      if (Array.isArray(d.sOpt)) [].slice.call(document.querySelectorAll('.sOpt')).forEach(function(c, i){ if (typeof d.sOpt[i] === 'boolean') c.checked = d.sOpt[i]; });
    } catch(e){}
  }

  FIELDS.forEach(function(id){ $(id).addEventListener('input', build); });
  $('uLower').addEventListener('change', build);
  $('uSpace').addEventListener('change', build);
  restore(); drawHistory(); build(); suffix();
})();
</script>
