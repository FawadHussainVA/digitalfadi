<section class="wrap narrow pt0">
  <div class="prose">
    <h2>The break-even ROAS formula</h2>
    <p>Break-even ROAS = order value &divide; profit per order before ad costs. Put another way, it is 1 divided by your margin before ads. A product with a 50% margin breaks even at a ROAS of 2. A product with a 20% margin needs a ROAS of 5 just to stand still. That is why two shops with the same ROAS can have completely different results.</p>

    <h2>Costs people forget</h2>
    <ul>
      <li><strong>VAT or sales tax</strong> in the tracked conversion value, which inflates ROAS without adding a penny of profit.</li>
      <li><strong>Payment fees</strong>, small per order but charged on every one.</li>
      <li><strong>Returns and refunds</strong>, which Google Ads counted as revenue at the time of the sale.</li>
      <li><strong>Delivery and packing</strong>, especially where free delivery is offered.</li>
    </ul>

    <h2>From break-even to a target ROAS</h2>
    <p>Breaking even on the first order can still make sense when customers come back, but it should be a decision, not an accident. Set the profit you want to keep and the calculator gives the target ROAS to enter in Google Ads, as a percentage. Raise targets in steps rather than all at once, because a big jump can stall spend while bidding relearns. If the account reports a healthy ROAS but the profit never shows up in the bank, the cause is often inflated conversion values, which is the first thing a <a href="/google-ads-audit/">$100 account analysis</a> checks. To turn raw cost and revenue into ROAS, use the <a href="/tools/metrics-calculator/">metrics calculator</a>.</p>
  </div>
</section>

<script>
(function(){
  'use strict';
  var $ = function(id){ return document.getElementById(id); };
  var KEY = 'df_beroas_v1';
  var IDS = ['bCur','bAov','bCogs','bShip','bFeeP','bFeeF','bRet','bOther','bMargin','bVat','bProfit','bNow'];
  var mode = 'detail';

  function v(id){ var x = parseFloat($(id).value); return isFinite(x) && x >= 0 ? x : 0; }
  function has(id){ return $(id).value.trim() !== ''; }
  function cur(n){
    try { return new Intl.NumberFormat(undefined, { style:'currency', currency:$('bCur').value, minimumFractionDigits:2, maximumFractionDigits:2 }).format(n); }
    catch(e){ return n.toFixed(2); }
  }
  function r2(n){ return n.toLocaleString(undefined, { minimumFractionDigits:2, maximumFractionDigits:2 }); }
  function dash(ids){ ids.forEach(function(id){ $(id).textContent = '\u2013'; }); }

  function calc(){
    $('bVatWrap').hidden = !$('bVatOn').checked;
    var vat = $('bVatOn').checked ? v('bVat') / 100 : 0;
    var err = $('oErr'); err.hidden = true;
    /* share = profit before ads as a fraction of the value Google Ads reports */
    var share = null, contrib = null, tracked = null, net = null;

    if (mode === 'detail'){
      if (has('bAov') && v('bAov') > 0){
        tracked = v('bAov'); net = tracked / (1 + vat);
        var fees = tracked * v('bFeeP') / 100 + v('bFeeF');
        contrib = net - v('bCogs') - v('bShip') - fees - net * v('bRet') / 100 - v('bOther');
        share = contrib / tracked;
      }
    } else if (has('bMargin')){
      tracked = 100; net = 100 / (1 + vat);
      contrib = net * v('bMargin') / 100; share = contrib / tracked;
    }

    var outIds = ['oContrib','oMargin','oCpa','oTarget','oTcpa'];
    if (share === null){
      $('oBe').textContent = '\u2013'; $('oBeSub').textContent = mode === 'detail' ? 'Enter your order value and costs to see the minimum ROAS.' : 'Enter your margin before ad costs.';
      dash(outIds); $('oNow').textContent = 'Enter the ROAS your account is reporting.';
      $('oTable').innerHTML = '<tr><td colspan="6" class="l" style="color:var(--slate)">Fill in your costs to see the table.</td></tr>';
      save(); return;
    }
    if (contrib <= 0){
      $('oBe').textContent = 'Not possible';
      $('oBeSub').textContent = '';
      err.textContent = mode === 'simple' ? 'With no margin before ad costs, no ROAS can break even.'
        : 'Each order ' + (contrib < 0 ? 'loses ' + cur(-contrib) : 'makes nothing') + ' before any advertising, so no ROAS can break even. Lower costs or raise prices first.';
      err.hidden = false; dash(outIds);
      $('oTable').innerHTML = ''; save(); return;
    }

    var be = 1 / share;
    $('oBe').textContent = r2(be);
    $('oBeSub').textContent = 'Enter ' + Math.ceil(be * 100) + '% as the floor for target ROAS in Google Ads. Below this, every sale loses money.';
    $('oMargin').textContent = (contrib / net * 100).toFixed(1) + '%';
    if (mode === 'detail'){
      $('oContrib').textContent = cur(contrib);
      $('oCpa').textContent = cur(contrib);
    } else {
      $('oContrib').textContent = (contrib / net * 100).toFixed(1) + '% of each sale';
      $('oCpa').textContent = (share * 100).toFixed(1) + '% of order value';
    }

    var p = v('bProfit') / 100, allowed = contrib - net * p;
    if (!has('bProfit')){ $('oTarget').textContent = 'Add a profit goal'; $('oTcpa').textContent = '\u2013'; }
    else if (allowed <= 0){ $('oTarget').textContent = 'Goal is above your margin'; $('oTcpa').textContent = '\u2013'; }
    else {
      var tr = tracked / allowed;
      $('oTarget').textContent = r2(tr) + ' (' + Math.ceil(tr * 100) + '%)';
      $('oTcpa').textContent = mode === 'detail' ? cur(allowed) : (allowed / tracked * 100).toFixed(1) + '% of order value';
    }

    if (has('bNow') && v('bNow') > 0){
      var now = v('bNow'), per1000 = 1000 * now * share - 1000;
      $('oNow').innerHTML = '<span class="tk-tag ' + (per1000 >= 0 ? 'good' : 'bad') + '">' + (per1000 >= 0 ? 'Profitable' : 'Losing money') + '</span> ' +
        'At a ROAS of ' + r2(now) + ', every ' + cur(1000) + ' of ad spend ' + (per1000 >= 0 ? 'leaves ' + cur(per1000) + ' profit' : 'loses ' + cur(-per1000)) + ' after ad costs.';
    } else $('oNow').textContent = 'Enter the ROAS your account is reporting.';

    var levels = [1, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10];
    if (levels.indexOf(Math.round(be * 100) / 100) === -1) levels.push(Math.round(be * 100) / 100);
    levels.sort(function(a, b){ return a - b; });
    $('oTable').innerHTML = levels.map(function(l){
      var rev = 1000 * l, gp = rev * share, np = gp - 1000, isBe = Math.abs(l - be) < 0.005;
      return '<tr' + (isBe ? ' class="sel"' : '') + '><td>' + r2(l) + (isBe ? ' <b>(break-even)</b>' : '') + '</td><td>' + Math.round(l * 100) + '%</td><td>' + cur(rev) + '</td><td>' + cur(gp) + '</td>' +
        '<td' + (np < -0.005 ? ' class="zero"' : '') + '>' + cur(np) + '</td><td class="l"><span class="tk-tag ' + (np > 0.005 ? 'good' : np < -0.005 ? 'bad' : 'soft') + '">' + (np > 0.005 ? 'Profit' : np < -0.005 ? 'Loss' : 'Break-even') + '</span></td></tr>';
    }).join('');
    save();
  }

  [].slice.call(document.querySelectorAll('[data-mode]')).forEach(function(b){
    b.addEventListener('click', function(){
      mode = b.dataset.mode;
      document.querySelectorAll('[data-mode]').forEach(function(x){ x.classList.toggle('on', x === b); x.setAttribute('aria-pressed', x === b); });
      $('bDetail').hidden = mode !== 'detail'; $('bSimple').hidden = mode !== 'simple';
      calc();
    });
  });
  $('bClear').addEventListener('click', function(){
    IDS.forEach(function(id){ if (id !== 'bCur' && id !== 'bVat') $(id).value = ''; });
    $('bVat').value = '20'; $('bVatOn').checked = false;
    try { localStorage.removeItem(KEY); } catch(e){}
    calc();
  });

  function save(){ try { var d = { m: mode, vatOn: $('bVatOn').checked }; IDS.forEach(function(id){ d[id] = $(id).value; }); localStorage.setItem(KEY, JSON.stringify(d)); } catch(e){} }
  function restore(){
    try {
      var d = JSON.parse(localStorage.getItem(KEY) || 'null'); if (!d) return;
      IDS.forEach(function(id){ if (typeof d[id] === 'string') $(id).value = d[id]; });
      $('bVatOn').checked = !!d.vatOn;
      if (d.m === 'simple') document.querySelector('[data-mode="simple"]').click();
    } catch(e){}
  }
  IDS.forEach(function(id){ $(id).addEventListener(id === 'bCur' ? 'change' : 'input', calc); });
  $('bVatOn').addEventListener('change', calc);
  restore(); calc();
})();
</script>
