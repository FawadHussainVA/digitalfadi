{% include "tool-ui.njk" %}

<section class="wrap tk">
  <div class="split">
    <div>
      <div class="fcard">
        <div class="fcard-head"><b>1. Ready-made groups</b><span>Click a word to drop it</span></div>
        <div class="tk-body" id="kGroups"></div>
      </div>
      <div class="fcard">
        <div class="fcard-head"><b>2. Your own negatives</b><span>One per line</span></div>
        <div class="tk-body">
          <div class="field">
            <label for="kCustom">Extra negatives</label>
