    <div>
      <div class="fcard">
        <div class="fcard-head"><b>3. Your negative list</b><span><span id="kCount">0</span> keywords</span></div>
        <div class="tk-body">
          <div class="tk-seg" role="group" aria-label="Match type">
            <button type="button" class="btn sm on" data-m="phrase" aria-pressed="true">Phrase "word"</button>
            <button type="button" class="btn sm" data-m="exact" aria-pressed="false">Exact [word]</button>
            <button type="button" class="btn sm" data-m="broad" aria-pressed="false">Broad word</button>
