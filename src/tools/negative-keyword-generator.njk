          </div>
          <div class="field">
            <label for="kLoc">Places you do not serve</label>
            <textarea id="kLoc" class="tk-area" style="min-height:90px" placeholder="Towns, counties or countries outside your area" spellcheck="false"></textarea>
          </div>
          <div class="field" style="margin-bottom:0">
            <label for="kComp">Brand names to exclude</label>
            <textarea id="kComp" class="tk-area" style="min-height:90px" placeholder="Other brands you do not sell or want to bid on" spellcheck="false"></textarea>
            <span class="tk-hint">Only exclude brands if you have decided not to bid on them. Some accounts do well on them.</span>
          </div>
