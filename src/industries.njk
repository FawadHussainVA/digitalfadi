---
layout: base.njk
permalink: /industries/
title: "Google Ads by Industry | DigitalFadi"
description: "How Google Ads works differently in each industry: what to measure, which campaign types fit, and the mistakes that cost the most, sector by sector."
---
<script type="application/ld+json">
{"@context":"https://schema.org","@graph":[
{"@type":"CollectionPage","name":{{ title | dump | safe }},"description":{{ description | dump | safe }},"url":"{{ site.url }}/industries/",
 "mainEntity":{"@type":"ItemList","itemListElement":[
  {%- for c in categories %}
  {"@type":"ListItem","position":{{ loop.index }},"url":"{{ site.url }}{{ c.url }}","name":{{ ("Google Ads for " + (c.name | lower)) | dump | safe }}},
  {%- endfor %}
  {%- set n = categories | length %}
  {%- for t in collections.industries | sort(false, false, 'data.order') %}
  {"@type":"ListItem","position":{{ n + loop.index }},"url":"{{ site.url }}{{ t.url }}","name":{{ t.data.heading | dump | safe }}}{% if not loop.last %},{% endif %}
  {%- endfor %}
 ]}},
{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"},{"@type":"ListItem","position":2,"name":"Industries","item":"{{ site.url }}/industries/"}]}
]}
</script>
<div class="phero">
  <div class="wrap phero-in">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Industries</span>
    </nav>
    <h1>Google Ads, <span class="hl">industry by industry</span></h1>
    <p>Search behaviour, customer value and what counts as a real lead are different in every market. Choose your industry to see how I structure campaigns, which rules apply and what to measure.</p>
    <nav class="ind-jump" aria-label="Industry categories">
      {%- for c in categories %}
      <a class="ind-tile" href="#{{ c.key }}"><i class="ind-ic"><svg viewBox="0 0 24 24" aria-hidden="true">{{ c.icon | safe }}</svg></i><span><b>{{ c.name }}</b><small>{{ c.types | length }} business types</small></span></a>
      {%- endfor %}
    </nav>
  </div>
</div>

<section class="wrap ind-wrap" aria-label="Industries">
  {%- for c in categories %}
  <div class="ind-block" id="{{ c.key }}">
    <div class="ind-main">
      <i class="ind-ic ind-ic-lg"><svg viewBox="0 0 24 24" aria-hidden="true">{{ c.icon | safe }}</svg></i>
      <h2>Google Ads for <span class="hl">{{ c.name | lower }}</span></h2>
      <p class="ind-sum">{{ c.summary }}</p>
      <p class="ind-label">Who this covers</p>
      <ul class="ind-types">
        {%- for t in c.types %}<li>{{ t }}</li>{% endfor %}
      </ul>
      <a class="btn" href="{{ c.url }}">Google Ads for {{ c.name | lower }} <span class="arw" aria-hidden="true">&rarr;</span></a>
    </div>
    <div class="ind-side">
      <p class="ind-label">Specialist pages</p>
      <div class="ind-pages">
        {%- for t in collections.industries | sort(false, false, 'data.order') %}{% if t.data.group == c.key %}
        <a class="ind-page" href="{{ t.url }}">
          <div class="ind-pt"><h3 class="ind-ph">{{ t.data.crumb }}</h3><span class="unit">{{ t.data.unit or "Sector" }}</span></div>
          <small>{{ t.data.description }}</small>
        </a>
        {%- endif %}{% endfor %}
      </div>
      <p class="ind-label">Guides</p>
      <ul class="ind-guides">
        {%- for g in c.guides %}{% for p in collections.posts %}{% if p.url == "/learn/" + g + "/" %}
        <li><a href="{{ p.url }}">{{ p.data.title }}</a></li>
        {%- endif %}{% endfor %}{% endfor %}
      </ul>
    </div>
  </div>
  {%- endfor %}
</section>

<div class="cta-band">
  <div class="wrap">
    <span class="eyebrow">Industry not listed?</span>
    <h2>The same approach works for most service businesses</h2>
    <p>Send me read-only access and I will list the issues in your Google Ads account, whatever your industry. No obligation and no slide deck.</p>
    <div class="cta-row">
      <a href="/#contact" class="btn">Get a free Google Ads audit <span class="arw" aria-hidden="true">&rarr;</span></a>
      <a href="{{ booking.url }}" class="btn ghost">{{ booking.label }}</a>
    </div>
  </div>
</div>
