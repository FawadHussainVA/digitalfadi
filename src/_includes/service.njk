---
layout: base.njk
servicePage: true
---
{%- set parentName = parent[0] if parent else "Google Ads Services" -%}
{%- set parentUrl = parent[1] if parent else "/#services" -%}
{%- set cat = (categories | categoryFor(group, page.url)) if parent else null -%}
{% block extrahead %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": {{ heading | dump | safe }},
  "description": {{ description | dump | safe }},
  "serviceType": {{ heading | dump | safe }},
  "url": "{{ site.url }}{{ page.url }}",
  "areaServed": {{ site.coreMarkets | dump | safe }},
  "provider": {"@id": "{{ site.url }}/#organization"}
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"},
    {"@type":"ListItem","position":2,"name":{{ parentName | dump | safe }},"item":"{{ site.url }}{{ parentUrl }}"},
    {%- if cat %}
    {"@type":"ListItem","position":3,"name":{{ cat.name | dump | safe }},"item":"{{ site.url }}{{ cat.url }}"},
    {"@type":"ListItem","position":4,"name":{{ crumb | dump | safe }},"item":"{{ site.url }}{{ page.url }}"}
    {%- else %}
    {"@type":"ListItem","position":3,"name":{{ crumb | dump | safe }},"item":"{{ site.url }}{{ page.url }}"}
    {%- endif %}
  ]
}
</script>
{% endblock %}
<div class="service-page">
  <div class="service-hero">
    <div class="wrap">
      <nav class="crumb service-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="{{ parentUrl }}">{{ parentName }}</a>
        <span aria-hidden="true">/</span>
        {%- if cat %}
        <a href="{{ cat.url }}">{{ cat.name }}</a>
        <span aria-hidden="true">/</span>
        {%- endif %}
        <span aria-current="page">{{ crumb }}</span>
      </nav>
      <div class="service-grid">
        <div class="service-intro">
          <a class="service-partner" href="{{ partner.url }}" target="_blank" rel="noopener">{{ partner.tier }} <span aria-hidden="true">&#x2197;&#xFE0E;</span></a>
          <h1>{{ heading }}</h1>
          <p>{{ standfirst }}</p>
          {% if serviceFacts %}
          <dl class="service-facts">
            {% for fact in serviceFacts %}
            <div><dt>{{ fact[0] }}</dt><dd>{{ fact[1] }}</dd></div>
            {% endfor %}
          </dl>
          {% endif %}
          <div class="service-actions">
            <a href="#enquiry" class="btn">Get a free audit <span class="arw" aria-hidden="true">&rarr;</span></a>
            <a href="/#pricing" class="service-text-link">See pricing <span aria-hidden="true">&rarr;</span></a>
          </div>
          <p class="service-reassurance">Read-only access is enough for the audit.</p>
        </div>

        <div class="fcard service-form" id="enquiry" role="region" aria-label="Free Google Ads audit" tabindex="-1">
          <div class="service-form-intro">
            <h2>Request a free Google Ads audit</h2>
            <p>I’ll identify issues in your account. There’s no obligation.</p>
          </div>
          <form name="account-analysis" method="POST" action="/api/contact" data-leadform data-form-id="service-audit">
            <input type="hidden" name="form-name" value="account-analysis">
            <input type="hidden" name="page" value="{{ crumb }}">
            <p class="hp"><label>Leave this empty <input type="text" name="bot-field" tabindex="-1" autocomplete="off"></label></p>
            <div class="service-fields">
              <div class="field">
                <label for="s-name">Your name</label>
                <input id="s-name" name="name" type="text" autocomplete="name" required placeholder="Full name">
              </div>
              <div class="field">
                <label for="s-email">Email</label>
                <input id="s-email" name="email" type="email" autocomplete="email" required placeholder="you@company.com">
              </div>
              <div class="field">
                <label for="s-phone">Phone / WhatsApp <span class="service-optional">(optional)</span></label>
                <input id="s-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="30" placeholder="+44 …">
              </div>
              <div class="field">
                <label for="s-site">Website</label>
                <input id="s-site" name="website" type="text" autocomplete="url" required placeholder="yourcompany.com">
              </div>
              <div class="field service-budget">
                <label for="s-budget">Monthly Google Ads budget</label>
                <select id="s-budget" name="budget" required>
                  <option value="">Select a range</option>
                  <option>Under $1,000</option>
                  <option>$1,000 &ndash; $5,000</option>
                  <option>$5,000 &ndash; $20,000</option>
                  <option>$20,000 &ndash; $50,000</option>
                  <option>$50,000+</option>
                  <option>Not running Google Ads yet</option>
                </select>
              </div>
            </div>
            <div class="cf-turnstile" data-sitekey="0x4AAAAAAFSmQNY5L9j0Njly" data-size="flexible"></div>
            <button type="submit" class="btn fsubmit">Get my free audit</button>
            <p class="fnote">I’ll reply within one working day. For written fixes, see the <a href="{% if page.url == '/google-ads-audit/' %}#service-details{% else %}/google-ads-audit/{% endif %}">$100 account analysis</a>.</p>
          </form>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap service-grid service-body">
    <div class="service-main">
      <section aria-labelledby="service-details">
        <h2 class="service-section-title" id="service-details" tabindex="-1">{{ "Audit details" if page.url == "/google-ads-audit/" else "Service overview" }}</h2>
        <div class="prose service-prose">
{{ content | safe }}
        </div>
      </section>

      {% if faqs %}
      <section class="service-faq" aria-labelledby="service-faq" data-faq>
        <h2 class="service-section-title" id="service-faq">Common questions about {{ faqLabel or (crumb | lower) }}</h2>
        {%- for f in faqs %}
        <details>
          <summary>{{ f.q }}</summary>
          <p>{{ f.a }}</p>
        </details>
        {%- endfor %}
      </section>
      {% endif %}
    </div>

    <aside class="service-sidebar" aria-label="Contact and resources">
      <section class="service-panel service-contact" aria-labelledby="service-contact">
        <h2 id="service-contact">Talk to Fawad</h2>
        <ul>
          <li><a href="{{ booking.url }}" target="_blank" rel="noopener">{{ booking.label }}</a></li>
          <li><a href="mailto:{{ site.email }}?subject={{ crumb | urlencode }}%20enquiry">{{ site.email }}</a></li>
          <li><a href="https://wa.me/{{ site.whatsapp }}?text=Hi%20DigitalFadi%2C%20I%27d%20like%20to%20talk%20about%20{{ crumb | urlencode }}." target="_blank" rel="noopener">Message on WhatsApp</a></li>
        </ul>
      </section>

      {#- Prioritize articles on this page's topics, then fill with the latest posts. -#}
      {% set picked = [] %}
      {%- for topic in (related or []) -%}
        {%- for a in collections.posts | reverse -%}
          {%- if a.data.topic == topic and picked.length < 3 and not (a in picked) %}{% set picked = (picked.push(a), picked) %}{% endif -%}
        {%- endfor -%}
      {%- endfor -%}
      {%- for a in collections.posts | reverse -%}
        {%- if picked.length < 3 and not (a in picked) %}{% set picked = (picked.push(a), picked) %}{% endif -%}
      {%- endfor -%}
      <section class="service-panel service-resources" aria-labelledby="service-resources">
        <h2 id="service-resources">Related resources</h2>
        {% if picked.length %}
        <h3>Further reading</h3>
        <ul>
          {% for a in picked %}<li><a href="{{ a.url }}">{{ a.data.title }}</a></li>{% endfor %}
        </ul>
        {% endif %}
        {% if parent and collections.industries %}
        {% set rel = [] %}
        {%- for u in (relatedIndustries or []) %}{% for t in collections.industries %}{% if t.url == u %}{% set rel = (rel.push(t), rel) %}{% endif %}{% endfor %}{% endfor %}
        {%- for t in collections.industries | sort(false, false, 'data.order') %}{% if t.url != page.url and t.data.group == group and not (t in rel) and rel.length < 3 %}{% set rel = (rel.push(t), rel) %}{% endif %}{% endfor %}
        <h3>Related industries</h3>
        <ul>
          {% for t in rel %}<li><a href="{{ t.url }}">{{ t.data.crumb }}</a></li>{% endfor %}
          <li><a href="/industries/">See all industries</a></li>
        </ul>
        {% endif %}
        <h3>Free tools</h3>
        <ul>
          {% for t in (tools or []) %}<li><a href="{{ t[1] }}">{{ t[0] }}</a></li>{% endfor %}
          {% if not tools %}<li><a href="/tools/">Browse free Google Ads tools</a></li>{% endif %}
        </ul>
      </section>
    </aside>
  </div>

  <div class="wrap">
    <section class="service-cta" id="contact-cta" aria-labelledby="service-cta-title">
      <div>
        <h2 id="service-cta-title">Find out where your Google Ads budget goes</h2>
        <p>Start with a free review of your campaigns, keywords and placements.</p>
      </div>
      <a href="#enquiry" class="btn">Get a free audit <span class="arw" aria-hidden="true">&rarr;</span></a>
    </section>
  </div>
</div>
