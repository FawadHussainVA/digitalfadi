<meta property="og:locale" content="en_US">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "{{ site.url }}/#website",
      "url": "{{ site.url }}/",
      "name": "DigitalFadi",
      "description": "Fawad Hussain, freelance Google Ads specialist and Google Premier Partner: Google Ads management, audits and practical guides.",
      "inLanguage": "en",
      "publisher": {"@id": "{{ site.url }}/#organization"}
    },
    {
      "@type": "Organization",
      "@id": "{{ site.url }}/#organization",
      "name": "DigitalFadi",
      "url": "{{ site.url }}/",
      "logo": "{{ site.url }}/icon-512.png",
      "founder": {"@id": "{{ site.url }}/#fawad"},
      "award": {{ partner.tier | dump | safe }},
      "areaServed": {{ site.coreMarkets | dump | safe }},
      "sameAs": ["{{ site.upwork }}", "{{ site.linkedin }}", "{{ partner.url }}"]
    },
    {
      "@type": "Person",
      "@id": "{{ site.url }}/#fawad",
      "name": "Fawad Hussain",
      "jobTitle": "Google Ads Freelancer",
      "description": "Freelance Google Ads specialist and consultant. Google Premier Partner.",
      "url": "{{ site.url }}/about/",
      "worksFor": {"@id": "{{ site.url }}/#organization"},
      "knowsLanguage": ["English", "Urdu"],
      "knowsAbout": ["Google Ads", "PPC", "Google Shopping", "Performance Max", "Conversion tracking", "Google Analytics 4", "Local Services Ads", "Google Ads for law firms", "Google Ads for dental and medical clinics", "Google Ads for home services", "Google Ads for real estate", "Google Ads for e-commerce"],
      "sameAs": ["{{ site.upwork }}", "{{ site.linkedin }}"]
    }
  ]
}
</script>
