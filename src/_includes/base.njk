    <label for="waText" class="hp">Your message</label>
    <textarea id="waText" placeholder="Type your message&hellip;"></textarea>
    <button class="wa-send" id="waSend"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg> Start chat on WhatsApp</button>
  </div>
</div>

<script>
(function(){
  var WA_NUMBER = '{{ site.whatsapp }}';
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- desk feed (home only) ---------- */
  var tb = document.getElementById('rows');
  if(tb){
    var data = [
      {n:'Search: brand',   bid:0.84, cpa:11, w:1},
      {n:'Search: generic', bid:3.42, cpa:41, w:1},
      {n:'Shopping',              bid:0.71, cpa:26, w:1},
      {n:'Performance Max',       bid:1.18, cpa:29, w:0},
      {n:'YouTube in-stream',     bid:0.09, cpa:48, w:1},
      {n:'Display',               bid:0.42, cpa:57, w:0},
      {n:'Demand Gen',            bid:0.63, cpa:38, w:1},
      {n:'Remarketing',           bid:0.55, cpa:19, w:1}
    ];
    data.forEach(function(d){
      var tr = document.createElement('tr');
      tr.innerHTML = '<td>'+d.n+'</td>'+
        '<td class="num" data-k="bid">$'+d.bid.toFixed(2)+'</td>'+
        '<td class="num" data-k="cpa">$'+d.cpa+'</td>'+
        '<td class="num"><span class="pill '+(d.w?'won':'lost')+'">'+(d.w?'Won':'Outbid')+'</span></td>';
      tb.appendChild(tr);
    });
    if(!reduce){
      setInterval(function(){
        var i = Math.floor(Math.random()*data.length), d = data[i], row = tb.children[i];
        d.bid = Math.max(0.35, d.bid + (Math.random()-0.5)*0.22);
        d.cpa = Math.max(9, Math.round(d.cpa + (Math.random()-0.52)*4));
        d.w = Math.random() > 0.28 ? 1 : 0;
        var b = row.querySelector('[data-k="bid"]'), c = row.querySelector('[data-k="cpa"]');
        b.textContent = '$'+d.bid.toFixed(2);
        c.textContent = '$'+d.cpa;
        var p = row.querySelector('.pill');
        p.className = 'pill '+(d.w?'won':'lost');
        p.textContent = d.w?'Won':'Outbid';
        b.classList.add('flash'); c.classList.add('flash');
        setTimeout(function(){ b.classList.remove('flash'); c.classList.remove('flash'); },480);
      },1500);
    }
  }

  /* ---------- ticker ---------- */
  var track = document.getElementById('track');
  if(track){
    var chans = ['Search campaigns','Shopping campaigns','Performance Max','YouTube ads','Display','Demand Gen','Remarketing','Local Services Ads','Keyword research','Negative keywords','Merchant Center feeds','Enhanced conversions','GA4 & Tag Manager','Smart Bidding','RSA testing','Account analysis'];
    var h = chans.map(function(c){ return '<span>'+c+' \u00B7</span>'; }).join('');
    track.innerHTML = h + h;
  }

  /* ---------- scroll progress, header, back to top ---------- */
  var prog = document.getElementById('prog'), hdr = document.getElementById('hdr'), topBtn = document.getElementById('top');
  function onScroll(){
    var h = document.documentElement.scrollHeight - window.innerHeight;
    prog.style.width = (h > 0 ? (window.scrollY / h) * 100 : 0) + '%';
    hdr.classList.toggle('shrunk', window.scrollY > 40);
    topBtn.classList.toggle('on', window.scrollY > 600);
  }
  window.addEventListener('scroll', onScroll, {passive:true});
  onScroll();
  topBtn.addEventListener('click', function(){
    window.scrollTo({top:0, behavior: reduce ? 'auto' : 'smooth'});
  });

  /* ---------- reveals ---------- */
  if('IntersectionObserver' in window && !reduce){
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    },{threshold:.1, rootMargin:'0px 0px -50px 0px'});
    document.querySelectorAll('.rv,.stg').forEach(function(el){ io.observe(el); });
  } else {
    document.querySelectorAll('.rv,.stg').forEach(function(el){ el.classList.add('in'); });
  }

  /* ---------- counters ---------- */
  var figs = document.querySelectorAll('[data-to]');
  function runCount(el){
    var to = parseFloat(el.dataset.to), pre = el.dataset.pre || '', suf = el.dataset.suf || '';
    if(reduce){ el.textContent = pre + to + suf; return; }
    var start = null, dur = 1400;
    function step(t){
      if(!start) start = t;
      var p = Math.min((t - start)/dur, 1);
      var e = 1 - Math.pow(1 - p, 3);
      el.textContent = pre + Math.round(to * e) + suf;
      if(p < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }
  if('IntersectionObserver' in window){
    var io2 = new IntersectionObserver(function(es){
      es.forEach(function(e){ if(e.isIntersecting){ runCount(e.target); io2.unobserve(e.target); } });
    },{threshold:.5});
    figs.forEach(function(f){ io2.observe(f); });
  } else {
    figs.forEach(runCount);
  }

  /* ---------- filters (results + blog) ---------- */
  var fbar = document.querySelector('[data-filterbar]');
  if(fbar){
    var items = document.querySelectorAll('[data-tags]');
    var empty = document.querySelector('.noresult');
    fbar.addEventListener('click', function(e){
      var b = e.target.closest('.fbtn');
      if(!b) return;
      fbar.querySelectorAll('.fbtn').forEach(function(x){ x.classList.remove('on'); });
      b.classList.add('on');
      var f = b.dataset.f, shown = 0;
      items.forEach(function(it){
        var match = (f === 'all') || it.dataset.tags.split(' ').indexOf(f) > -1;
        it.classList.toggle('hidden', !match);
        if(match) shown++;
      });
      if(empty) empty.classList.toggle('hidden', shown > 0);
    });
  }

  /* ---------- newsletter (no backend: hands off to email) ---------- */
  var nform = document.querySelector('[data-newsletter]');
  if(nform){
    nform.addEventListener('submit', function(e){
      e.preventDefault();
      var v = nform.querySelector('input').value.trim();
      if(!v) return;
      window.location.href = 'mailto:{{ site.email }}?subject=' +
        encodeURIComponent('Subscribe to the desk notes') +
        '&body=' + encodeURIComponent('Please add ' + v + ' to the list.');
    });
  }


  /* ---------- lead forms ----------
     Posts to Web3Forms, which emails the submission straight through.
     The access key lives in src/_data/site.json, nowhere else.
     If the post fails for any reason the form falls back to opening the
     visitor's email client, so a submission is never silently lost. */
  var FORM_ENDPOINT = 'https://api.web3forms.com/submit';
  var FORM_EMAIL = '{{ site.email }}';

  function formDone(card, email){
    card.innerHTML =
      '<div class="fdone">' +
        '<div class="tick"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>' +
        '<h4>Request received</h4>' +
        '<p>Thanks. We\'ll reply to ' + email + ' within one working day, usually sooner.</p>' +
      '</div>';
  }

  function mailtoFallback(form, fd){
    var lines = [];
    fd.forEach(function(v, k){
      if(k === 'form-name' || k === 'bot-field' || !String(v).trim()) return;
      lines.push(k + ': ' + v);
    });
    window.location.href = 'mailto:' + FORM_EMAIL +
      '?subject=' + encodeURIComponent(
        fd.get('form-name') === 'account-analysis'
          ? 'Free Google Ads audit request'
          : 'Website enquiry') +
      '&body=' + encodeURIComponent(lines.join('\n'));
  }

  document.querySelectorAll('[data-leadform]').forEach(function(form){
    form.addEventListener('submit', function(e){
      e.preventDefault();
      var fd = new FormData(form);
      var card = form.closest('.fcard');
      var email = (fd.get('email') || 'you').toString();
      var btn = form.querySelector('.fsubmit');
      var label = btn.innerHTML;
      btn.disabled = true;
      btn.textContent = 'Sending\u2026';

      var payload = {};
      fd.forEach(function(v, k){
        if(k === 'bot-field') return;
        payload[k] = payload[k] ? payload[k] + ', ' + v : v;
      });
      payload.subject = fd.get('form-name') === 'account-analysis'
        ? 'Free Google Ads audit request'
        : 'Website enquiry';
      payload.from_name = 'digitalfadi website';
      fetch(FORM_ENDPOINT, {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'Accept': 'application/json'},
        body: JSON.stringify(payload)
      }).then(function(r){
        return r.json();
      }).then(function(d){
        if(!d || !d.success) throw new Error('rejected');
        formDone(card, email);
      }).catch(function(){
        btn.disabled = false;
        btn.innerHTML = label;
        mailtoFallback(form, fd);
      });
    });
  });

  /* ---------- whatsapp widget ---------- */
  var waBtn = document.getElementById('waBtn'),
      panel = document.getElementById('waPanel'),
      waX   = document.getElementById('waClose'),
      badge = document.getElementById('waBadge'),
      txt   = document.getElementById('waText'),
      dismissed = false;

  function openPanel(){
    panel.classList.add('open');
    waBtn.setAttribute('aria-expanded','true');
    badge.classList.add('hide');
    setTimeout(function(){ txt.focus(); }, 320);
  }
  function closePanel(){
    panel.classList.remove('open');
    waBtn.setAttribute('aria-expanded','false');
    dismissed = true;
  }
  waBtn.addEventListener('click', function(){
    panel.classList.contains('open') ? closePanel() : openPanel();
  });
  waX.addEventListener('click', closePanel);
  document.addEventListener('keydown', function(e){
    if(e.key === 'Escape' && panel.classList.contains('open')) closePanel();
  });
  setTimeout(function(){
    if(!dismissed && !panel.classList.contains('open')) openPanel();
  }, 12000);

  document.getElementById('chips').addEventListener('click', function(e){
    var c = e.target.closest('.chip');
    if(!c) return;
    document.querySelectorAll('.chip').forEach(function(x){ x.classList.remove('sel'); });
    c.classList.add('sel');
    txt.value = 'Hi digitalfadi - we are running ' + c.textContent + ' and would like an account audit.';
    txt.focus();
  });
  document.getElementById('waSend').addEventListener('click', function(){
    var m = txt.value.trim() || 'Hi digitalfadi - I would like an account audit.';
    window.open('https://wa.me/' + WA_NUMBER + '?text=' + encodeURIComponent(m), '_blank', 'noopener');
  });
  txt.addEventListener('keydown', function(e){
    if(e.key === 'Enter' && (e.metaKey || e.ctrlKey)) document.getElementById('waSend').click();
  });
  /* ---------- one-pager nav highlight (uses the existing nav a.on rule) ---------- */
  var navLinks = [].slice.call(document.querySelectorAll('nav[aria-label="Main"] a[href^="#"]'));
  if(navLinks.length && 'IntersectionObserver' in window){
    var spyTargets = navLinks.map(function(a){
      return document.getElementById(a.getAttribute('href').slice(1));
    }).filter(Boolean);
    if(spyTargets.length){
      var spy = new IntersectionObserver(function(es){
        es.forEach(function(e){
          if(!e.isIntersecting) return;
          navLinks.forEach(function(a){
            var on = a.getAttribute('href') === '#' + e.target.id;
            a.classList.toggle('on', on);
            if(on){ a.setAttribute('aria-current','true'); }
            else { a.removeAttribute('aria-current'); }
          });
        });
      }, {rootMargin:'-45% 0px -50% 0px'});
      spyTargets.forEach(function(t){ spy.observe(t); });
    }
  }

  /* ---------- mobile menu ---------- */
  var navToggle = document.getElementById('navToggle'),
      mainNav   = document.getElementById('mainnav');
  if(navToggle && mainNav){
    navToggle.addEventListener('click', function(){
      var open = mainNav.classList.toggle('open');
      navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
    mainNav.addEventListener('click', function(e){
      if(e.target.tagName === 'A'){
        mainNav.classList.remove('open');
        navToggle.setAttribute('aria-expanded','false');
        navToggle.setAttribute('aria-label','Open menu');
      }
    });
    document.addEventListener('keydown', function(e){
      if(e.key === 'Escape' && mainNav.classList.contains('open')){
        mainNav.classList.remove('open');
        navToggle.setAttribute('aria-expanded','false');
        navToggle.focus();
      }
    });
  }

})();

</script>
</body>
</html>
