<div class="wave wbot" aria-hidden="true"><svg viewBox="0 0 1440 48" preserveAspectRatio="none"><path fill="#6A5AE0" d="M0,20 C180,0 360,40 720,24 C1080,8 1260,44 1440,20 L1440,48 L0,48 Z"/><path fill="none" stroke="#14121F" stroke-width="3" vector-effect="non-scaling-stroke" d="M0,20 C180,0 360,40 720,24 C1080,8 1260,44 1440,20"/></svg></div>

