---
layout: base.njk
ogtype: article
---
{% block extrahead %}
<meta property="article:published_time" content="{{ date | iso }}">
<meta property="article:modified_time" content="{{ (updated or date) | iso }}">
<meta property="article:author" content="{{ site.linkedin }}">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "datePublished": "{{ date | iso }}",
  "dateModified": "{{ (updated or date) | iso }}",
  "author": {
    "@type": "Person",
    "@id": "{{ site.url }}/#fawad",
    "name": {{ site.authorName | dump | safe }},
    "jobTitle": "Google Ads Freelancer",
    "url": "{{ site.url }}/about/",
    "sameAs": ["{{ site.upwork }}", "{{ site.linkedin }}"]
  },
  "publisher": {"@type":"Organization","@id":"{{ site.url }}/#organization","name":"DigitalFadi","logo":{"@type":"ImageObject","url":"{{ site.url }}/icon-512.png"}},
  "image": "{{ site.url }}/og-image.png",
  "inLanguage": "en",
  "mainEntityOfPage": "{{ site.url }}{{ page.url }}"
}
</script>
{%- set articleFaqs = content | faqItems %}
{%- if articleFaqs.length %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for f in articleFaqs %}
    {"@type": "Question", "name": {{ f.q | dump | safe }}, "acceptedAnswer": {"@type": "Answer", "text": {{ f.a | dump | safe }}}}{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
{%- endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"},
    {"@type":"ListItem","position":2,"name":"Learn","item":"{{ site.url }}/learn/"},
    {"@type":"ListItem","position":3,"name":{{ title | dump | safe }},"item":"{{ site.url }}{{ page.url }}"}
  ]
}
</script>
{% endblock %}
<div class="phero ab-hero">
  <div class="wrap phero-in">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="{{ site.url }}/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="{{ site.url }}/learn/">Learn</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ topic }}</span>
    </nav>
    <div class="article-meta ab-meta">
      <i>{{ topic }}</i>
      <span>{{ readingTime }} min read</span>
    </div>
    <h1>{{ title }}</h1>
    <p class="ab-dek">{{ description }}</p>
    <a class="ab-by" href="/about/" rel="author">
      <span class="ab-av" aria-hidden="true">F</span>
      <span><b>{{ site.authorName }}</b><small>Google Ads freelancer, 2026 Google Premier Partner</small></span>
    </a>
  </div>
</div>

<article class="article ab">
  <div class="wrap ab-grid">
    <div class="ab-main">
      <details class="ab-tocm" hidden>
        <summary>On this page</summary>
        <ol class="ab-toc-list"></ol>
      </details>
      <div class="prose">
{{ content | safe }}
      </div>

      <div class="author">
        <span class="av" aria-hidden="true">F</span>
        <div>
          <p class="ab-auth"><b>Written by {{ site.authorName }}</b></p>
          <p>Freelance Google Ads specialist and founder of DigitalFadi, a 2026 Google Premier Partner. Five years running Google Ads for more than 100 businesses across the US, UK and Australia, and every account is managed personally. <a href="/about/" class="ab-more">More about me</a></p>
        </div>
      </div>
      <div class="share">
      <em>Share</em>
      <a data-b="li" href="https://www.linkedin.com/sharing/share-offsite/?url={{ (site.url + page.url) | urlencode }}" target="_blank" rel="noopener" aria-label="Share on LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>
      <a data-b="wa" href="https://wa.me/?text={{ (title + " " + site.url + page.url) | urlencode }}" target="_blank" rel="noopener" aria-label="Share on WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg></a>
    </div>
    </div>

    <aside class="ab-side" aria-label="Article tools">
      <div class="panel ab-toc" role="navigation" aria-label="On this page" hidden>
        <h2>On this page</h2>
        <ol class="ab-toc-list"></ol>
      </div>
      <div class="fcard ab-cta">
        <div class="fcard-head"><b>Free audit</b><span>No obligation</span></div>
        <div class="ab-cta-body">
          <p>Give read-only access to your Google Ads account and I&rsquo;ll send back a list of the issues in it: tracking, wasted spend and structure.</p>
          <a href="/#contact" class="btn sm">Get a free audit <span class="arw">&rarr;</span></a>
          <p class="ab-cta-alt">Want the fixes too? See the <a href="/google-ads-audit/">$100 account analysis</a>.</p>
        </div>
      </div>
      <div class="panel ab-links related-services">
        <h2>Related services</h2>
        <ul>
          <li><a href="/google-ads-audit/">Google Ads audit</a></li>
          <li><a href="/google-ads-for-ecommerce/">Google Ads for e-commerce</a></li>
          <li><a href="/google-ads-for-local-services/">Google Ads for local services</a></li>
        </ul>
        {%- set toolFor = {
          "Search": ["Negative keyword generator", "/tools/negative-keyword-generator/"],
          "Shopping": ["Break-even ROAS calculator", "/tools/break-even-roas-calculator/"],
          "Performance Max": ["Break-even ROAS calculator", "/tools/break-even-roas-calculator/"],
          "Tracking": ["UTM builder", "/tools/utm-builder/"],
          "Local Services": ["Cost per booked job calculator", "/tools/cost-per-booked-job-calculator/"],
          "Strategy": ["Budget calculator", "/tools/budget-calculator/"]
        } %}
        {%- set tf = toolFor[topic] or ["Google Ads metrics calculator", "/tools/metrics-calculator/"] %}
        <h2>Free tool</h2>
        <ul>
          <li><a href="{{ tf[1] }}">{{ tf[0] }}</a></li>
          <li><a href="/tools/">All free tools</a></li>
        </ul>
      </div>
    </aside>
  </div>
</article>

<style>
  /* Article layout. Page-specific block, like the tool pages; every class is prefixed ab-. */
  .ab-hero h1{font-size:clamp(1.9rem,4.4vw,3.3rem);max-width:24ch;margin:12px 0 16px}
  .ab-meta{border:0;padding:0;margin:0}
  .ab-dek{font-size:clamp(1.02rem,1.4vw,1.16rem);color:var(--slate);max-width:62ch;line-height:1.6}
  .ab-by{display:inline-flex;align-items:center;gap:12px;margin-top:24px}
  .ab-av{width:44px;height:44px;flex:none;border-radius:50%;background:var(--amber);border:var(--bd);display:grid;place-items:center;font-weight:800;color:#14121F}
  .ab-by b{display:block;font-size:.92rem;font-weight:800}
  .ab-by small{display:block;font-size:.8rem;color:var(--slate-l);font-weight:600}
  .ab-by:hover b{color:var(--purple)}

  .ab-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:clamp(32px,4.5vw,64px);align-items:start}
  .ab-main{max-width:720px;min-width:0}

  /* the opening paragraph is the direct answer, so it gets the most weight */
  .ab .prose > p:first-child{background:var(--bg-2);border:var(--bd);border-radius:var(--r);box-shadow:var(--sh);
    padding:22px 24px;font-size:1.12rem;line-height:1.65;font-weight:500;color:var(--ink)}
  .ab .prose h2{scroll-margin-top:96px;padding-top:36px;margin-top:44px;border-top:2px solid var(--hair)}
  .ab .prose > p:first-child + h2,.ab .prose > p:first-child + p + h2{border-top:0;padding-top:0}
  .ab .prose h3{scroll-margin-top:96px}
  .ab .prose blockquote{border-left:4px solid var(--purple);padding:4px 0 4px 18px;color:var(--slate);font-weight:500}
  .ab .prose table{width:100%;border-collapse:collapse;font-size:.95rem;display:block;overflow-x:auto}
  .ab .prose th,.ab .prose td{border:1px solid var(--hair);padding:9px 12px;text-align:left}
  .ab .prose th{background:var(--purple-xl);font-weight:800}
  .ab .prose .ab-faq{margin-top:18px}
  .ab .prose .ab-faq details p{font-size:.98rem}

  .ab .share{margin-top:28px}
  .ab .author .ab-auth{margin-bottom:6px;font-size:1.05rem;color:var(--ink)}
  .ab .author .ab-auth b{font-weight:800}
  .ab-more{color:var(--purple);font-weight:700;text-decoration:underline;text-underline-offset:3px}

  .ab-side{position:sticky;top:96px;display:flex;flex-direction:column;gap:20px}
  .ab-side .panel{padding:18px 20px 16px}
  .ab-side h2{font-size:.95rem;margin:0 0 10px}
  .ab-toc-list{list-style:none;margin:0;padding:0;counter-reset:t;max-height:46vh;overflow-y:auto}
  .ab-toc-list li{counter-increment:t}
  .ab-toc-list a{display:flex;gap:9px;padding:6px 8px;margin:0 -8px;border-radius:var(--r-sm);font-size:.86rem;font-weight:600;line-height:1.35;color:var(--slate)}
  .ab-toc-list a::before{content:counter(t);flex:none;font-size:.74rem;font-weight:800;color:var(--slate-l);min-width:14px;font-variant-numeric:tabular-nums;padding-top:1px}
  .ab-toc-list a:hover{background:var(--purple-xl);color:var(--ink)}
  .ab-toc-list a.on{background:var(--purple-l);color:var(--ink)}
  .ab-toc-list a.on::before{color:var(--purple)}
  .ab-cta-body{padding:20px}
  .ab-cta-body p{font-size:.9rem;color:var(--slate);margin-bottom:14px}
  .ab-cta-body .btn{width:100%}
  .ab-cta-body .ab-cta-alt{font-size:.8rem;margin:12px 0 0}
  .ab-cta-alt a,.ab-links a{color:var(--purple);font-weight:700}
  .ab-links ul{list-style:none;margin:0 0 14px;padding:0}
  .ab-links ul:last-child{margin-bottom:0}
  .ab-links li{font-size:.88rem;padding:6px 0;border-top:1px solid var(--hair)}
  .ab-links li:first-child{border-top:0}
  .ab-links a:hover{text-decoration:underline;text-underline-offset:3px}
  [data-theme="dark"] .ab-cta-alt a,[data-theme="dark"] .ab-links a,[data-theme="dark"] .ab-more,[data-theme="dark"] .ab-by:hover b{color:#B3AAFF}

  .ab-tocm{margin:0 0 26px}
  .ab-tocm .ab-toc-list{max-height:none;padding:0 22px 16px}

  @media(max-width:1000px){
    .ab-grid{grid-template-columns:1fr}
    .ab-main{max-width:none}
    .ab-side{position:static}
    .ab-toc{display:none}
  }
  @media(min-width:1001px){ .ab-tocm{display:none} }
  @media(max-width:680px){ .ab .prose > p:first-child{font-size:1.02rem;padding:18px 18px} }
</style>
<script>
(function(){
  'use strict';
  var prose = document.querySelector('.ab .prose');
  if(!prose) return;
  function slug(t){ return t.toLowerCase().replace(/&/g,' and ').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,60) || 'section'; }

  /* FAQ: the h3 and answer pairs under "Frequently asked questions" become accordions.
     The text is unchanged, so it still matches the FAQ schema built from it. */
  var faqH = [].filter.call(prose.querySelectorAll('h2'), function(h){ return /^frequently asked questions$/i.test(h.textContent.trim()); })[0];
  if(faqH){
    var box = document.createElement('div'); box.className = 'ab-faq';
    var n = faqH.nextElementSibling;
    while(n && n.tagName === 'H3'){
      var q = n, parts = [], m = q.nextElementSibling;
      while(m && m.tagName !== 'H3' && m.tagName !== 'H2'){ parts.push(m); m = m.nextElementSibling; }
      /* after the last question, only the first paragraph is the answer; anything after it stays outside */
      if(!m || m.tagName !== 'H3') parts = parts.slice(0, 1);
      var d = document.createElement('details'), sm = document.createElement('summary');
      sm.textContent = q.textContent; d.appendChild(sm);
      parts.forEach(function(el){ d.appendChild(el); });
      box.appendChild(d); q.remove();
      n = (m && m.tagName === 'H3') ? m : null;
    }
    faqH.after(box);
  }

  /* contents, from the h2s */
  var hs = [].slice.call(prose.querySelectorAll('h2')), used = {};
  if(hs.length >= 3){
    var html = hs.map(function(h){
      var id = h.id || slug(h.textContent); while(used[id] || (document.getElementById(id) && document.getElementById(id) !== h)) id += '-2';
      used[id] = 1; h.id = id;
      return '<li><a href="' + '#' + id + '">' + h.textContent.replace(/&/g,'&amp;').replace(/</g,'&lt;') + '</a></li>';
    }).join('');
    [].forEach.call(document.querySelectorAll('.ab-toc-list'), function(l){ l.innerHTML = html; });
    [].forEach.call(document.querySelectorAll('.ab-toc,.ab-tocm'), function(el){ el.hidden = false; });
    if(location.hash){ var t = document.getElementById(decodeURIComponent(location.hash.slice(1))); if(t) t.scrollIntoView(); }
    document.querySelector('.ab-tocm').addEventListener('click', function(e){ if(e.target.closest('a')) this.open = false; });
    if('IntersectionObserver' in window){
      var links = document.querySelectorAll('.ab-toc .ab-toc-list a');
      var io = new IntersectionObserver(function(es){
        es.forEach(function(e){
          if(!e.isIntersecting) return;
          [].forEach.call(links, function(a){ var on = a.getAttribute('href') === '#' + e.target.id; a.classList.toggle('on', on); if(on) a.setAttribute('aria-current','true'); else a.removeAttribute('aria-current'); });
        });
      }, {rootMargin:'-20% 0px -70% 0px'});
      hs.forEach(function(h){ io.observe(h); });
    }
  }
})();
</script>

{#- Keep reading: same topic first (newest first), then the newest others, three in total -#}
{%- set related = [] %}
{%- for a in collections.posts | reverse %}
  {%- if a.url != page.url and a.data.topic == topic and related.length < 3 %}{% set related = (related.push(a), related) %}{% endif %}
{%- endfor %}
{%- for a in collections.posts | reverse %}
  {%- if a.url != page.url and not (a in related) and related.length < 3 %}{% set related = (related.push(a), related) %}{% endif %}
{%- endfor %}
{%- if related.length %}
<section class="wrap pt0 related-posts">
  <div class="sec-head rv">
    <span class="eyebrow">Keep reading</span>
    <h2>More on <span class="hl">Google Ads</span></h2>
  </div>
  <div class="posts stg">
  {%- for p in related %}
    <a class="post" href="{{ p.url }}">
      <div class="post-meta">
        <i>{{ p.data.topic }}</i>
      </div>
      <h3>{{ p.data.title }}</h3>
      <p>{{ p.data.description }}</p>
      <span class="more">{{ p.data.readingTime }} min read <span>&rarr;</span></span>
    </a>
  {%- endfor %}
  </div>
  <p class="sec-head" style="margin:28px auto 0"><a href="/learn/" class="btn ghost">All articles <span class="arw">&rarr;</span></a></p>
</section>
{%- endif %}

