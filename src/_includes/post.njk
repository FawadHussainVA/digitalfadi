---
layout: base.njk
ogtype: article
---
{% block extrahead %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "datePublished": "{{ date | iso }}",
  "dateModified": "{{ date | iso }}",
  "author": {
    "@type": "Person",
    "name": {{ site.authorName | dump | safe }},
    "jobTitle": "Google Ads specialist",
    "url": "{{ site.url }}/#about",
    "sameAs": ["{{ site.upwork }}", "{{ site.linkedin }}"]
  },
  "publisher": {"@type":"Organization","name":"digitalfadi","logo":{"@type":"ImageObject","url":"{{ site.url }}/icon-512.png"}},
  "mainEntityOfPage": "{{ site.url }}{{ page.url }}"
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"},
    {"@type":"ListItem","position":2,"name":"Learn","item":"{{ site.url }}/learn/"},
    {"@type":"ListItem","position":3,"name":{{ title | dump | safe }},"item":"{{ site.url }}{{ page.url }}"}
  ]
}
</script>
{% endblock %}
<div class="phero">
  <div class="wrap phero-in narrow">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="{{ site.url }}/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="{{ site.url }}/learn/">Learn</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ topic }}</span>
    </nav>
    <h1 style="font-size:clamp(1.9rem,4.4vw,3.4rem);max-width:26ch">{{ title }}</h1>
  </div>
</div>

<article class="article">
  <div class="wrap narrow">
    <div class="article-meta">
      <i>{{ topic }}</i>
      <span>{{ date | readable }}</span>
      <span>{{ readingTime }} min read</span>
      <span>By {{ site.authorName }}</span>
    </div>
    <div class="prose">
{{ content | safe }}
    </div>
